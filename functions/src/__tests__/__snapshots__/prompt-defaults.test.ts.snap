exports[`prompt defaults (golden copy) > forecast.en 1`] = `
{
  "maxOutputTokens": 2800,
  "model": "claude-sonnet-4-6",
  "system": "You are an astrologer describing today's cosmic weather. Use only the natal chart and today's date. Write warmly and plainly, with no concrete event predictions and no medical/legal/financial advice.",
  "temperature": 0.5,
  "user": "Today is 2026-10-18. Natal chart:

Time known: yes
Zodiac: tropical
Planet positions:
Sun: Aries 12.50 deg (house: 10)
Moon: Leo 5.25 deg (house: 2)
Venus: Pisces 20.10 deg (house: 9)
Mars: Sagittarius 12.75 deg (house: unknown)
Major planetary aspects:
Sun trine Mars (orb 0.25 deg, exactness 0.97)
Moon square Venus (orb 5.15 deg, exactness 0.52)
Sun trine Moon (orb 7.25 deg, exactness 0.40)

Give a detailed personal horoscope for today in this format (use ## for headings):

## Today's vibe — a short phrase

2 full paragraphs (5-7 sentences) about the overall tone of the day, how the energy shifts from morning to evening, and which natal placements stand out most today (explain any astrology term immediately in plain words).

## In focus

4-5 detailed bullet points (-), 2-3 sentences each, covering concrete themes for the day: work and decisions, communication and close relationships, emotional tone and energy, rest and personal pace.

## Practical guidance for today

1-2 paragraphs (4-6 sentences) on what to lean into today, where flow comes easiest, and what is best not to rush or force.

400-600 words. No fluff or generic clichés. End with the line: [END_OF_REPORT]",
}
`;

exports[`prompt defaults (golden copy) > forecast.ru 1`] = `
{
  "maxOutputTokens": 2800,
  "model": "claude-sonnet-4-6",
  "system": "Ты астролог, описывающий «космическую погоду» дня. Опирайся только на натальную карту и текущую дату. Пиши тепло и понятно, без предсказаний конкретных событий, без медицинских/юридических/финансовых советов.",
  "temperature": 0.5,
  "user": "Сегодня 2026-10-18. Натальная карта:

Time known: yes
Zodiac: tropical
Planet positions:
Sun: Aries 12.50 deg (house: 10)
Moon: Leo 5.25 deg (house: 2)
Venus: Pisces 20.10 deg (house: 9)
Mars: Sagittarius 12.75 deg (house: unknown)
Major planetary aspects:
Sun trine Mars (orb 0.25 deg, exactness 0.97)
Moon square Venus (orb 5.15 deg, exactness 0.52)
Sun trine Moon (orb 7.25 deg, exactness 0.40)

Дай подробный персональный гороскоп на сегодня в таком формате (используй ## для заголовков):

## Настроение дня — короткая фраза

2 развёрнутых абзаца (5-7 предложений) об общем тоне дня, динамике с утра к вечеру и о том, какие особенности натальной карты сегодня звучат особенно ярко (астрологические термины сразу поясняй простыми словами).

## Что в фокусе

4-5 подробных пунктов-маркеров (-) по 2-3 предложения каждый с конкретными темами дня: дела и решения, общение и близкие отношения, внутреннее состояние и энергия, отдых и личный ритм.

## Совет на день

1-2 абзаца (4-6 предложений): на что лучше опереться сегодня, какие шаги дадутся легче и от чего стоит воздержаться.

Объем 400-600 слов. Без воды и общих шаблонов. Заверши строкой: [END_OF_REPORT]",
}
`;

exports[`prompt defaults (golden copy) > letterAnalysis.en.coldStart 1`] = `
{
  "maxOutputTokens": 1500,
  "model": "claude-opus-4-8",
  "system": "Аналитический движок письма личного астролога. ТОЛЬКО JSON: {"themes":[1-2],"chosenTransits":[string],"newsHooks":[string],"callbacks":[],"effectiveRegister":{"humor":0..1,"seriousness":0..1,"warmth":0..1,"note":string},"questions":[{"text":string,"options":[2-3],"dossierKey":string,"sensitive":bool}]}. Выбери 2-3 значимых транзита из списка; newsHooks бери из дайджеста; ≤3 коротких вопроса, заполняющих ТОЛЬКО пробелы досье. КРИТИЧНО: НЕ задавай вопросы, ответы на которые уже есть в 'ЧТО УЖЕ ИЗВЕСТНО', и НЕ повторяй темы из 'УЖЕ СПРАШИВАЛ'. Если новых пробелов нет — верни пустой массив questions. effectiveRegister = styleProfile ⊕ контекст: серьёзный/тревожный недавний вопрос → приглуши humor, подними seriousness/warmth (read the room).",
  "temperature": null,
  "user": "ДОСЬЕ: {"language":"en","addressForm":"feminine","interests":["travel","music"],"goals":["new job"],"openLoops":["moving abroad"],"styleProfile":{"humor":0.4,"seriousness":0.5,"formality":0.2,"warmth":0.6,"brevity":0.6,"mysticism":0.4,"emoji":0.2},"styleNudge":null}
